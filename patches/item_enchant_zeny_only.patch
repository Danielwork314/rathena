+void clif_enchantwindow_open_zeny( map_session_data& sd, uint64 clientLuaIndex ){
+#if PACKETVER_RE_NUM >= 20211103 || PACKETVER_MAIN_NUM >= 20220330
+	clif_enchantwindow_open( sd, clientLuaIndex );
+
+	// The plain group ID is sent to the client. The high bit is server-only state.
+	if( sd.state.item_enchant_index == clientLuaIndex ){
+		sd.state.item_enchant_index |= ITEM_ENCHANT_ZENY_ONLY_FLAG;
+	}
+#endif
+}
